<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage async="false" continueOnError="false" enabled="true" name="AM-Translate-MCP-Credentials">
  <DisplayName>AM-Translate-MCP-Credentials</DisplayName>
  <Set>
    <Headers>
      <Header name="X-MCP-User-Authorization">{request.header.Authorization}</Header>
      <Header name="X-Apigee-Verified-Email">{mcp_token.email}</Header>
      <Header name="X-Apigee-Verified-Scopes">{mcp_token.scope}</Header>
    </Headers>
  </Set>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
