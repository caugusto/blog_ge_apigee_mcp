# ==============================================================================
# Configuration for Internal MCP Behind Apigee X + Gemini Enterprise
# Copy to .env (`cp .env.example .env`) OR simply run `./deploy.sh --background`
# and answer the interactive prompts to generate .env automatically.
# ==============================================================================

# Required: Active Google Cloud Billing Account ID (e.g., 012345-6789AB-CDEF01)
BILLING_ACCOUNT_ID=""

# Two Google Cloud Project IDs (created automatically if they do not exist yet)
HUB_PROJECT_ID=""
APIGEE_PROJECT_ID=""

# Primary Region for Apigee X, Cloud Run, ALBs, PSC, Agent Gateway & Registry
REGION="us-central1"
GE_LOCATION="global"

# Gemini Enterprise Intranet App ID & Company Display Name (created automatically)
GE_APP_ID="ge-apigee-mcp-app"
COMPANY_NAME="Enterprise AI"

# Web OAuth 2.0 Client in HUB_PROJECT_ID
# Authorized redirect URI: https://vertexaisearch.cloud.google.com/oauth-redirect
# (If left blank, ./deploy.sh prints the exact Console URL after creating
# HUB_PROJECT_ID and prompts you to paste them interactively.)
OAUTH_CLIENT_ID=""
OAUTH_CLIENT_SECRET=""

# Internal DNS & Private IP Addressing (defaults work out of the box)
COUNTRIES_HOST="mcp-countries.corp.internal"
HUB_APIGEE_ILB_IP="10.10.1.30"
SB_ILB_IP="10.30.1.10"
