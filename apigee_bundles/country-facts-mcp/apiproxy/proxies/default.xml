<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <Description>Internal PSC Northbound Proxy Endpoint for Country Facts MCP</Description>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>SA-RateLimit</Name>
      </Step>
      <Step>
        <Name>AM-Translate-MCP-Credentials</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows/>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <HTTPProxyConnection>
    <BasePath>/</BasePath>
  </HTTPProxyConnection>
  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
